# ---- Core ----
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_NAME=DREAMZONE
TIME_ZONE=Asia/Tashkent

# ---- PostgreSQL ----
DB_NAME=bandwise
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ---- AI evaluation (Writing + Speaking) ----
# AI_PROVIDER: anthropic | openai | gemini  (Gemini keys: https://aistudio.google.com/apikey)
AI_PROVIDER=anthropic
AI_API_KEY=
# Leave empty for the provider default (anthropic: claude-opus-5-5, openai: gpt-4o)
AI_MODEL=
# Anthropic reasoning effort: low | medium | high | xhigh | max
AI_EFFORT=high
AI_TIMEOUT=180
AI_FEEDBACK_LANGUAGE=English

# ---- Speech-to-text (Speaking) ----
# STT_PROVIDER: openai | gemini  (Anthropic has no speech-to-text API)
STT_PROVIDER=openai
STT_API_KEY=
# whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
STT_MODEL=

# thread = background thread pool, sync = inline, queue = only `manage.py process_ai_queue`
AI_TASK_MODE=thread
AI_WORKERS=3

# ---- Uploads (MB) ----
MAX_IMAGE_MB=5
MAX_DOCUMENT_MB=25
MAX_VIDEO_MB=500
MAX_AUDIO_MB=60
MAX_RECORDING_MB=25

# ---- Email (console backend prints reset links in the terminal) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DREAMZONE <no-reply@localhost>

# ---- Optional S3-compatible storage (pip install django-storages[s3]) ----
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
